<!-- Firewall y politica de segmentacion - Obligatorio SRD 2026 -->
<group name="pfsense,segmentacion,">

  <rule id="100100" level="5">
    <decoded_as>pfsense-filterlog</decoded_as>
    <action>block</action>
    <description>Firewall: paquete bloqueado</description>
  </rule>

  <rule id="100101" level="10" frequency="10" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Firewall: multiples paquetes bloqueados desde el mismo origen en un minuto</description>
  </rule>

  <rule id="100102" level="12">
    <if_sid>100100</if_sid>
    <srcip>10.10.200.0/24</srcip>
    <dstip>10.10.99.0/24</dstip>
    <description>Violacion de politica: usuario de VPN intento alcanzar la red de administracion</description>
  </rule>

  <rule id="100103" level="12">
    <if_sid>100100</if_sid>
    <srcip>10.10.200.0/24</srcip>
    <dstip>10.10.30.0/24</dstip>
    <description>Violacion de politica: usuario de VPN intento alcanzar la red de servidores</description>
  </rule>

  <rule id="100104" level="10">
    <if_sid>100100</if_sid>
    <srcip>10.10.20.0/24</srcip>
    <dstip>10.10.99.0/24</dstip>
    <description>Violacion de politica: puesto de usuario intento alcanzar la red de administracion</description>
  </rule>

</group>

<!-- Acceso remoto por VPN - Obligatorio SRD 2026 -->
<group name="pfsense,openvpn,acceso_remoto,">

  <rule id="100110" level="0">
    <decoded_as>pfsense-openvpn</decoded_as>
    <description>OpenVPN: evento del firewall</description>
  </rule>

  <rule id="100111" level="3">
    <if_sid>100110</if_sid>
    <status>^connected$</status>
    <description>VPN: $(srcuser) conectado al servidor $(extra_data) desde $(srcip)</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100112" level="3">
    <if_sid>100110</if_sid>
    <status>^disconnected$</status>
    <description>VPN: $(srcuser) desconectado del servidor $(extra_data)</description>
  </rule>

  <rule id="100113" level="5">
    <if_sid>100110</if_sid>
    <match>could not authenticate</match>
    <description>VPN: autenticacion fallida del usuario $(srcuser)</description>
    <group>authentication_failed,</group>
  </rule>


  <rule id="100115" level="8">
    <if_sid>100111</if_sid>
    <extra_data>^ovpns2$</extra_data>
    <description>VPN: acceso con perfil de administradores - usuario $(srcuser) desde $(srcip)</description>
  </rule>

</group>

<!-- Deteccion de prueba de credenciales en la VPN - Obligatorio SRD 2026 -->
<group name="pfsense,openvpn,acceso_remoto,">

  <rule id="100116" level="3">
    <if_sid>100110</if_sid>
    <match>Peer Connection Initiated</match>
    <description>VPN: negociacion iniciada por $(srcuser) desde $(srcip)</description>
  </rule>

  <rule id="100117" level="10" frequency="3" timeframe="180">
    <if_matched_sid>100113</if_matched_sid>
    <same_srcuser />
    <description>VPN: tres autenticaciones fallidas de $(srcuser) en tres minutos - posible prueba de credenciales</description>
    <group>authentication_failures,</group>
  </rule>

</group>
