{#
  Flujo de n8n: priorización y propuesta de soluciones.

  El script del nodo "Code" NO vive acá: se lee de
  vulnmgmt/n8n/priorizar-soluciones.js, que es la única fuente de verdad y se
  puede revisar y versionar como código normal. "to_json" lo convierte en una
  cadena JSON válida (comillas y saltos de línea escapados), y al venir de un
  archivo aparte Jinja nunca lo interpreta.

  El "id" del flujo es fijo: así "n8n import:workflow" actualiza el flujo que
  ya existe en lugar de crear una copia nueva en cada corrida del rol.
#}
{%- set script = lookup('file', playbook_dir ~ '/vulnmgmt/n8n/priorizar-soluciones.js')
      | regex_replace('https://<servidor-wazuh>:8443/', vulnmgmt_panel_url) -%}
{
  "name": "Gestión de vulnerabilidades - plan priorizado de remediación",
  "nodes": [
    {
      "parameters": {
        "content": "## Gestión de vulnerabilidades\nCada lunes 08:00 lee el último informe del motor (panel web en el propio servidor Wazuh) y el nodo *Priorizar y proponer soluciones* arma el plan de trabajo: ordena las acciones por urgencia, propone una solución y una verificación para cada una, y las agrupa en ventanas de mantenimiento.\n\nLa prioridad P1-P4 la calcula el motor (CVSS + EPSS + KEV + criticidad). El script **no** la recalcula y **no** construye comandos: reusa los que publica el motor, ya validados.\n\n**Para activar el envío:** abrir el nodo *Enviar correo*, cargar la credencial SMTP de la organización, completar remitente/destinatario y quitar *Deactivate*. Luego activar el flujo.\n\n**Para cambiar el alcance:** abrir el nodo *Priorizar y proponer soluciones* y editar `PRIORIDADES_AVISO` y `MAX_ACCIONES` arriba del script.",
        "height": 420,
        "width": 460
      },
      "id": "6d8f1c0e-1a2b-4c3d-8e9f-000000000001",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-160, -420]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [1],
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "6d8f1c0e-1a2b-4c3d-8e9f-000000000002",
      "name": "Cada lunes 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {},
      "id": "6d8f1c0e-1a2b-4c3d-8e9f-000000000003",
      "name": "Ejecución manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200]
    },
    {
      "parameters": {
        "url": "https://127.0.0.1:8443/data/latest.json",
        "options": {
          "timeout": 30000
        }
      },
      "id": "6d8f1c0e-1a2b-4c3d-8e9f-000000000004",
      "name": "Leer informe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 100]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": {{ script | to_json }}
      },
      "id": "6d8f1c0e-1a2b-4c3d-8e9f-000000000005",
      "name": "Priorizar y proponer soluciones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 100]
    },
    {
      "parameters": {
        "fromEmail": {{ vulnmgmt_n8n_mail_from | to_json }},
        "toEmail": {{ vulnmgmt_n8n_mail_to | to_json }},
        "subject": "={{ '{{' }} $json.asunto {{ '}}' }}",
        "emailFormat": "text",
        "text": "={{ '{{' }} $json.cuerpo {{ '}}' }}",
        "options": {}
      },
      "id": "6d8f1c0e-1a2b-4c3d-8e9f-000000000006",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [760, 100],
      "disabled": true
    }
  ],
  "connections": {
    "Cada lunes 08:00": {
      "main": [[{ "node": "Leer informe", "type": "main", "index": 0 }]]
    },
    "Ejecución manual": {
      "main": [[{ "node": "Leer informe", "type": "main", "index": 0 }]]
    },
    "Leer informe": {
      "main": [[{ "node": "Priorizar y proponer soluciones", "type": "main", "index": 0 }]]
    },
    "Priorizar y proponer soluciones": {
      "main": [[{ "node": "Enviar correo", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "id": "vulnmgmtWeekly01"
}
