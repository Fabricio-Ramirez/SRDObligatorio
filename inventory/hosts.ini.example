# Example inventory for running the playbook from a control node over SSH.
# Copy to inventory/hosts.ini and adapt. The user must be able to sudo.
#
#   ansible-playbook -i inventory/hosts.ini site.yml --ask-become-pass

[rocky_servers]
srv-idp      ansible_host=10.0.10.11
srv-siem     ansible_host=10.0.10.12
srv-bastion  ansible_host=10.0.10.10

[rocky_servers:vars]
ansible_user=admin
ansible_python_interpreter=/usr/bin/python3

# Unused alternative: another server that reads the Wazuh indexer of srv-siem
# (vulnmgmt_wazuh_host in host_vars/srv-vulnmgmt.yml). Left empty on purpose.
[vulnmgmt_server]
# srv-vulnmgmt ansible_host=10.0.10.20

[vulnmgmt_server:vars]
ansible_user=admin
ansible_python_interpreter=/usr/bin/python3

# Wazuh server: the vulnerability platform (vulnmgmt.yml) and n8n run here.
[wazuh_server]
srv-siem     ansible_host=10.0.10.12

[wazuh_server:vars]
ansible_user=admin
ansible_python_interpreter=/usr/bin/python3
